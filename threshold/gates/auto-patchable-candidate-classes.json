{
  "schemaVersion": "threshold.petclinic.auto-patchable-gate.v0.1",
  "gateId": "petclinic-auto-patchable-candidate-class-gate-v0-1",
  "purpose": "Require an explicit gate artifact before a discovered candidate class can be treated as autoPatchable by the autonomous runner.",
  "promotionPolicy": {
    "newCandidateClassRequiresGateEntry": true,
    "newExecutorRequiresGateEntry": true,
    "batchReceiptModeRequiresGateEntry": true,
    "missingGateEntryMeansReviewOnly": true,
    "gateEntryDoesNotBypassLeaseAllowlist": true,
    "gateEntryDoesNotBypassValidation": true
  },
  "scopeExpansionPolicy": {
    "enabled": true,
    "minimumAutoPatchableCandidates": 1,
    "description": "When the current lease scope yields too few auto-patchable candidates, advance through pre-authorized threshold tiers instead of stopping at the baseline thresholds.",
    "tiers": [
      {
        "tier": 0,
        "name": "baseline",
        "description": "Conservative baseline thresholds for already approved Java readability candidates.",
        "thresholds": {
          "longLineThreshold": 120,
          "commentWrapThreshold": 120,
          "springDataQueryThreshold": 80,
          "repositoryMethodLengthThreshold": 8,
          "utilityMethodLengthThreshold": 8
        }
      },
      {
        "tier": 1,
        "name": "expanded_readability_thresholds",
        "description": "Lower line-length and method-size thresholds for the same already approved candidate classes.",
        "thresholds": {
          "longLineThreshold": 100,
          "commentWrapThreshold": 100,
          "springDataQueryThreshold": 70,
          "repositoryMethodLengthThreshold": 6,
          "utilityMethodLengthThreshold": 6
        }
      },
    {
      "tier": 2,
      "name": "aggressive_readability_thresholds",
      "description": "Final bounded expansion tier for the same candidate classes before the runner reports scope exhaustion.",
      "thresholds": {
        "longLineThreshold": 92,
        "commentWrapThreshold": 96,
        "springDataQueryThreshold": 60,
        "repositoryMethodLengthThreshold": 5,
        "utilityMethodLengthThreshold": 5
      }
    },
    {
      "tier": 3,
      "name": "portfolio_expansion_readability_push",
      "description": "Additional exploratory readability expansion designed for authorized portfolio-restart lanes.",
      "thresholds": {
        "longLineThreshold": 80,
        "commentWrapThreshold": 84,
        "springDataQueryThreshold": 50,
        "repositoryMethodLengthThreshold": 4,
        "utilityMethodLengthThreshold": 4
      }
    }
  ]
  },
  "batchReceiptMode": {
    "schemaVersion": "threshold.petclinic.batch-receipt-mode.v0.1",
    "enabled": true,
    "maxSlicesPerBatch": 3,
    "maxFilesPerBatch": 3,
    "maxChangedLinesPerBatch": 120,
    "fullMavenTest": "onceAfterBatch",
    "sourceCommitPolicy": "one_source_commit_per_batch",
    "receiptCommitPolicy": "one_batch_receipt_commit_per_batch",
    "failurePolicy": "revert_entire_batch_before_commit",
    "approvedCandidateClasses": [
      {
        "candidateClass": "comment_wrap_cleanup",
        "authorizedBy": "retrospective-human-gate-for-auto-patchable-candidate-classes-v0-1",
        "scope": "pilot batch mode for independent single-line Javadoc comment wraps only",
        "requiresDiscoveryCanary": true,
        "requiresSameCandidateClassPerBatch": true
      },
      {
        "candidateClass": "repository_readability_cleanup",
        "authorizedBy": "scope-push-v0-repository-readability-auto-patchable",
        "scope": "repository SQL constant extraction and split-string normalization cleanup",
        "requiresDiscoveryCanary": true,
        "requiresSameCandidateClassPerBatch": true
      },
      {
        "candidateClass": "spring_data_query_wrap_cleanup",
        "authorizedBy": "scope-push-v0-spring-data-query-auto-patchable",
        "scope": "format-only wrapping of long Spring Data @Query annotation lines",
        "requiresDiscoveryCanary": true,
        "requiresSameCandidateClassPerBatch": true
      }
    ],
    "heldCandidateClasses": [
    ]
  },
  "approvedAutoPatchableCandidateClasses": [
    {
      "candidateClass": "comment_wrap_cleanup",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "single long Javadoc comment line wrapping only",
      "requiresCanary": true
    },
    {
      "candidateClass": "line_comment_wrap_cleanup",
      "authorizedBy": "scope-executor-expansion-v0-1",
      "scope": "single long Java // comment line wrapping only",
      "requiresCanary": true
    },
    {
      "candidateClass": "duplicate_literal_local_constant_extraction",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "same-class private string constant extraction for repeated literals",
      "requiresCanary": true
    },
    {
      "candidateClass": "method_signature_wrap_cleanup",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "format-only wrapping of long Java method signatures",
      "requiresCanary": true
    },
    {
      "candidateClass": "method_spacing_normalization",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "single blank-line insertion between adjacent methods",
      "requiresCanary": true
    },
    {
      "candidateClass": "private_helper_extraction_for_readability",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "existing runner-supported line cleanup only",
      "requiresCanary": true
    },
    {
      "candidateClass": "redundant_local_variable_simplification",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "immediate return-local simplification only",
      "requiresCanary": true
    },
    {
      "candidateClass": "repository_readability_cleanup",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "repository SQL constant extraction and split string normalization only",
      "requiresCanary": true
    },
    {
      "candidateClass": "spring_data_query_wrap_cleanup",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "format-only wrapping of long Spring Data @Query annotations",
      "requiresCanary": true
    },
    {
      "candidateClass": "spring_data_query_concat_wrap_cleanup",
      "authorizedBy": "scope-expansion-v0-spring-data-concat",
      "scope": "format-only wrapping of concatenated Spring Data @Query annotations",
      "requiresCanary": true
    },
    {
      "candidateClass": "split_string_constant_normalization",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "canonical two-line continuation for already split string constants",
      "requiresCanary": true
    },
    {
      "candidateClass": "string_constant_wrap_cleanup",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "format-only wrapping of long private static final string constants",
      "requiresCanary": true
    },
    {
      "candidateClass": "utility_readability_cleanup",
      "authorizedBy": "governance-hardening-bootstrap",
      "scope": "runner-supported StopWatch helper extraction only",
      "requiresCanary": true
    },
    {
      "candidateClass": "application_bootstrap_readability_cleanup",
      "authorizedBy": "scope-executor-expansion-v0-3",
      "scope": "format-only wrapping of long top-level Spring bootstrap invocation lines with string arguments",
      "requiresCanary": true
    },
    {
      "candidateClass": "leading_tab_indentation_cleanup",
      "authorizedBy": "scope-executor-expansion-v0-leading-tab-indentation",
      "scope": "format-only normalization of one contiguous leading-tab indentation block to spaces",
      "requiresCanary": true
    },
    {
      "candidateClass": "model_readability_cleanup",
      "authorizedBy": "scope-executor-expansion-v0-model-toString",
      "scope": "model toString helper extraction for chained ToStringCreator append blocks",
      "requiresCanary": true
    }
  ],
  "nonClaims": [
    "gate entry is not a behavior-preservation claim",
    "gate entry is not a public readiness claim",
    "gate entry is not a public correctness claim",
    "gate entry does not authorize push, PR, merge, release, or deploy"
  ]
}
